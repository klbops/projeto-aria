# ════════════════════════════════════════════════
#  ARIA — Environment Variables
#  cp .env.example .env  →  preencha os campos
# ════════════════════════════════════════════════

# ── App ──────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── Database ─────────────────────────────────────
POSTGRES_PASSWORD=aria_secret
DATABASE_URL=postgresql://aria_user:aria_secret@postgres:5432/aria_db

# ── Telegram ─────────────────────────────────────
# 1. Abra @BotFather no Telegram → /newbot
# 2. Copie o token abaixo
TELEGRAM_BOT_TOKEN=

# 3. Mande uma mensagem pro seu bot
# 4. Abra: https://api.telegram.org/bot<TOKEN>/getUpdates
# 5. Copie o "id" dentro de "chat"
TELEGRAM_CHAT_ID=

# ── Gemini AI ─────────────────────────────────────
# https://aistudio.google.com/app/apikey  (gratuito)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── OpenWeather (opcional) ────────────────────────
# https://openweathermap.org/api  (plano free)
OPENWEATHER_API_KEY=
WEATHER_CITY=São Paulo
WEATHER_COUNTRY=BR

# ── Webhook (só em produção com HTTPS) ────────────
# WEBHOOK_URL=https://seudominio.com.br
